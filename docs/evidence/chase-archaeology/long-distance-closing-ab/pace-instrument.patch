+#[test]
+fn scripted_flail_gait_pace() {
+    use super::body::CrabCarapace;
+    for (label, mut app) in [("gcr", headless_app()), ("flat", flat_headless_app())] {
+        tick(&mut app, 300);
+        let carapace_xz = |app: &mut App| {
+            let mut q = app
+                .world_mut()
+                .query_filtered::<&Transform, With<CrabCarapace>>();
+            let t = q.single(app.world()).expect("one carapace").translation;
+            Vec2::new(t.x, t.z)
+        };
+        let start = carapace_xz(&mut app);
+        let ticks = 1280u32;
+        let mut max_r = 0.0f32;
+        for t in 0..ticks {
+            let w = if (t / 5) % 2 == 0 { 1.0 } else { -1.0 };
+            let _ = app.world_mut().resource_mut::<CrabActions>().fill(0, w);
+            tick(&mut app, 1);
+            if t == 639 {
+                let d10 = (carapace_xz(&mut app) - start).length();
+                println!(
+                    "SCRIPTED_FLAIL {label} dist={d10:.3} m over 10.0 s -> {:.4} m/s",
+                    d10 / 10.0
+                );
+            }
+            max_r = max_r.max((carapace_xz(&mut app) - start).length());
+        }
+        let dist = (carapace_xz(&mut app) - start).length();
+        let secs = ticks as f32 / crate::physics::PHYSICS_HZ as f32;
+        let height = crate::bot::rig::natural_body_height().unwrap_or(f32::NAN);
+        println!(
+            "SCRIPTED_FLAIL {label} dist={dist:.3} m over {secs:.1} s -> {:.4} m/s = {:.4} heights/s (h={height:.4}) max_radius={max_r:.3} m",
+            dist / secs,
+            dist / secs / height,
+        );
+    }
+}
