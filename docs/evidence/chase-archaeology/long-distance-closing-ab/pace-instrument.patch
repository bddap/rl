+#[test]
+fn open_loop_gait_search() {
+    use super::actuator::ACTION_SIZE;
+    use super::body::CrabCarapace;
+    let mut s: u64 = 0x9e3779b97f4a7c15;
+    let mut rnd = move || {
+        s ^= s << 13;
+        s ^= s >> 7;
+        s ^= s << 17;
+        (s >> 11) as f32 / (1u64 << 53) as f32
+    };
+    let trials: usize = std::env::var("GAIT_TRIALS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(96);
+    let periods = [6.0f32, 10.0, 16.0, 24.0, 32.0, 48.0, 64.0, 96.0];
+    let mut best = (0.0f32, String::new());
+    for i in 0..trials {
+        let period = periods[i % periods.len()];
+        let square = (i / periods.len()) % 2 == 1;
+        let amp: [f32; ACTION_SIZE] = std::array::from_fn(|_| if rnd() < 0.5 { -1.0 } else { 1.0 });
+        let phase: [f32; ACTION_SIZE] = std::array::from_fn(|_| rnd() * std::f32::consts::TAU);
+        let bias: [f32; ACTION_SIZE] = std::array::from_fn(|_| (rnd() - 0.5) * 0.6);
+        let mut app = flat_headless_app();
+        tick(&mut app, 300);
+        let carapace_xz = |app: &mut App| {
+            let mut q = app
+                .world_mut()
+                .query_filtered::<&Transform, With<CrabCarapace>>();
+            let t = q.single(app.world()).expect("one carapace").translation;
+            Vec2::new(t.x, t.z)
+        };
+        let start = carapace_xz(&mut app);
+        for t in 0..1280u32 {
+            let row: [f32; ACTION_SIZE] = std::array::from_fn(|j| {
+                let x = (std::f32::consts::TAU * t as f32 / period + phase[j]).sin();
+                let x = if square { x.signum() } else { x };
+                (amp[j] * x + bias[j]).clamp(-1.0, 1.0)
+            });
+            let _ = app
+                .world_mut()
+                .resource_mut::<CrabActions>()
+                .set_row(0, row);
+            tick(&mut app, 1);
+        }
+        let dist = (carapace_xz(&mut app) - start).length();
+        let tag = format!("trial={i} period={period} square={square}");
+        println!("GAIT {tag} dist20s={dist:.3}");
+        if dist > best.0 {
+            best = (dist, tag);
+        }
+    }
+    println!(
+        "GAIT_BEST dist20s={:.3} m ({}) over {trials} trials",
+        best.0, best.1
+    );
+}
